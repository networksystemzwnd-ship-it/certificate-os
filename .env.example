# LOCAL DEVELOPMENT ONLY — these values are intentionally non-production.
APP_ENV=development
API_PORT=8080
LOG_LEVEL=info

POSTGRES_USER=certos
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=certos
# Runtime connection: the RESTRICTED role (row-level security applies to it). Created automatically in
# development from APP_DB_USER/APP_DB_PASSWORD when MIGRATE_ON_START=true (ADR-001).
DATABASE_URL=postgres://certos_app:local-dev-only-app-role-pw@postgres:5432/certos?sslmode=disable
# Owner connection: migrations and role provisioning ONLY. Required (and must differ) in production.
MIGRATE_DATABASE_URL=postgres://certos:local-dev-only-change-me@postgres:5432/certos?sslmode=disable
APP_DB_USER=certos_app
APP_DB_PASSWORD=local-dev-only-app-role-pw
MIGRATE_ON_START=true

MINIO_ROOT_USER=minio-local
MINIO_ROOT_PASSWORD=local-dev-only-change-me
S3_ENDPOINT=http://minio:9000
S3_BUCKET=certos-private

# Email delivery of certificates (M5b). EMAIL_PROVIDER=none disables sending (the API answers 503 "email_unavailable").
# Local development with Mailpit (inbox at http://localhost:8025 if your compose runs it):
#   EMAIL_PROVIDER=smtp  EMAIL_FROM=no-reply@certificateos.local  SMTP_HOST=mailpit  SMTP_PORT=1025  SMTP_TLS=none
# Production: smtp + starttls (587) or tls (465), credentials from your provider, a sender address you are allowed to use.
# SMTP_PASSWORD is a secret: never commit it and never log it.
EMAIL_PROVIDER=none
EMAIL_FROM=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8080

# Browser origin allowed to call the API (CORS/CSRF). Must be https in production.
WEB_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=12

# Certificate PDFs (M4b). Issuing returns 503 until PDF_CHROME_PATH points at a pinned headless Chromium
# (see docs/runbooks/certificate-pdf-rendering.md). PUBLIC_BASE_URL is printed in every certificate's QR code.
PUBLIC_BASE_URL=http://localhost:5173
PDF_CHROME_PATH=
PDF_CHROME_NO_SANDBOX=false
PDF_MAX_CONCURRENT=2
