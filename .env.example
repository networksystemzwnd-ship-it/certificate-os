# LOCAL DEVELOPMENT ONLY — these values are intentionally non-production.
APP_ENV=development
API_PORT=8080
LOG_LEVEL=info

POSTGRES_USER=certos
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=certos
DATABASE_URL=postgres://certos:local-dev-only-change-me@postgres:5432/certos?sslmode=disable
MIGRATE_ON_START=true

MINIO_ROOT_USER=minio-local
MINIO_ROOT_PASSWORD=local-dev-only-change-me
S3_ENDPOINT=http://minio:9000
S3_BUCKET=certos-private

SMTP_HOST=mailpit
SMTP_PORT=1025

WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8080
